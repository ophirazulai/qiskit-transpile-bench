        "NO_IMPROVEMENT",
        "CONSTRAINT_VIOLATION",
        "INCONCLUSIVE",
        "ERROR"
      ]
    },
    "improved_under_constraints": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "profile": {
      "type": "string"
    },
    "hashes": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "harness",
              "correctness",
              "guard",
              "cost",
              "improvement",
              "completeness"
            ]
          },
          "subject": {
            "enum": [
