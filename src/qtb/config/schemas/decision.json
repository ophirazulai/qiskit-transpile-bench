              "passed_on_rerun",
              "failed",
              "unresolved",
              "not_evaluated"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "subject",
          "result"
        ],
        "additionalProperties": true,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://qiskit-transpile-bench.invalid/schemas/constraint/1"
