    },
    "objective": {
      "type": "array",
      "items": {"type": "object"}
    },
    "trade_score": {
      "type": ["number", "null"]
    },
    "zero_baseline_deltas": {
      "type": "object"
    },
    "exclusions": {
      "type": ["object", "array"]
    },
    "cost_thresholds": {
      "type": ["object", "null"]
    },
    "seed_block": {
      "const": "B0"
    }
